@model BacklogManager.DTOs.DashboardViewModel

@{
    ViewData["Title"] = "Strona Główna";
}

<div class="p-5 mb-5 bg-dark text-white rounded-3 shadow">
    <div class="container-fluid py-4 text-center">
        <h1 class="display-5 fw-bold mb-3">Witaj w Backlog Manager!</h1>
        <p class="col-md-8 mx-auto fs-5 text-light">
            Twoje osobiste centrum dowodzenia. Śledź swoje postępy, oceniaj ukończone tytuły i planuj, w co zagrasz w następnej kolejności.
        </p>
        <div class="mt-4">
            <a asp-controller="Game" asp-action="Index" class="btn btn-primary btn-lg px-4 me-md-2 shadow-sm">Przeglądaj Katalog</a>
            <a asp-controller="UserGames" asp-action="Index" class="btn btn-outline-light btn-lg px-4 shadow-sm">Moja Biblioteka</a>
        </div>
    </div>
</div>

<h3 class="mb-4 fw-bold text-secondary">Twoje podsumowanie</h3>
<div class="row text-center mb-5">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body py-4">
                <h6 class="card-title text-muted text-uppercase fw-bold">Gier w systemie</h6>
                <h2 class="display-4 fw-bold text-secondary">@Model.TotalGamesInSystem</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body py-4">
                <h6 class="card-title text-muted text-uppercase fw-bold">Gry w bibliotece</h6>
                <h2 class="display-4 fw-bold text-primary">@Model.MyLibraryCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body py-4">
                <h6 class="card-title text-muted text-uppercase fw-bold">Ukończone</h6>
                <h2 class="display-4 fw-bold text-success">@Model.CompletedCount</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-light h-100">
            <div class="card-body py-4">
                <h6 class="card-title text-muted text-uppercase fw-bold">W trakcie gry</h6>
                <h2 class="display-4 fw-bold text-warning">@Model.PlayingCount</h2>
            </div>
        </div>
    </div>
</div>

<h3 class="mb-4 fw-bold text-secondary">Propozycje dla Ciebie</h3>
<div class="row row-cols-1 row-cols-md-4 g-4">
    @foreach (var game in Model.RecommendedGames)
    {
        <div class="col game-card">
            <div class="card h-100 shadow-sm border-0 rounded-3">
                <img src="@game.ImageUrl" onerror="this.onerror=null; this.src='/images/placeholder.jgp';" class="card-img-top rounded-top" alt="Okładka" style="object-fit: cover; height: 350px;">
                
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-bold text-truncate" title="@game.Title">@game.Title</h5>
                    <p class="card-text text-muted small mb-1">@game.Developer &bull; @game.ReleaseYear</p>
                    
                    <div class="mt-auto pt-2">
                        <span class="badge bg-dark mb-3">@game.Genre</span>
                        
                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <button type="button" class="btn btn-outline-success w-100 fw-bold quick-add-btn" data-game-id="@game.Id">
                                + Do biblioteki
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary w-100 fw-bold">Zaloguj by dodać</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.RecommendedGames.Any())
{
    <div class="alert alert-info text-center mt-4">
        Masz już wszystkie dostępne gry w swojej bibliotece! Zagraj w coś z kolekcji.
    </div>
}

@section Scripts {
    <script src="~/js/QuickAdd.js"></script>
}