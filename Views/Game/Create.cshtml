@model BacklogManager.DTOs.GameCreateViewModel

@{
    ViewData["Title"] = "Dodaj nową grę";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">Dodaj nową grę do katalogu</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Tytuł Gry</label>
                            <input asp-for="Title" class="form-control" placeholder="Wpisz pełny tytuł..." required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Developer" class="form-label fw-bold">Studio deweloperskie</label>
                                <input asp-for="Developer" class="form-control" placeholder="np. CD Projekt RED" required />
                            </div>
                            
                            <div class="col-md-6 mb-3">
                                <label asp-for="ReleaseYear" class="form-label fw-bold">Rok wydania</label>
                                <input asp-for="ReleaseYear" type="number" class="form-control" value="2024" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Genre" class="form-label fw-bold">Gatunek</label>
                            <input asp-for="Genre" class="form-control" placeholder="np. RPG, Akcja, Strategia" required />
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label fw-bold">Link do okładki</label>
                            <input asp-for="ImageUrl" class="form-control" id="imageUrlInput" placeholder="https://..." />
                            
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="usePlaceholderCheck">
                                <label class="form-check-label text-muted small" for="usePlaceholderCheck">
                                    Nie mam linku, użyj domyślnej okładki systemowej
                                </label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                          
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                Powrót do listy
                            </a>

                            <button type="submit" class="btn btn-success fw-bold px-4">
                                Zapisz Grę
                            </button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script src="~/js/ImagePlaceholder.js"></script>
}