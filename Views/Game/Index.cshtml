@model Test.DTOs.GameCatalogViewModel

@{
    ViewData["Title"] = "Katalog Gier";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-secondary">Globalny Katalog Gier</h2>
        @if (Context.Session.GetString("UserRole") == "Admin")
        {
            <a asp-action="Create" class="btn btn-primary">+ Dodaj nową grę do bazy</a>
        }
    </div>

    <div class="mb-4 bg-light p-3 rounded-3 shadow-sm border">
        <div class="row g-2">
            <div class="col-md-8">
                <input type="text" id="searchInput" class="form-control" placeholder="Szukaj gry po tytule">
            </div>
            <div class="col-md-4">
                <select id="genreFilter" class="form-select">
                    <option value="ALL">Wszystkie gatunki</option>
                    @foreach (var genre in Model.AvailableGenres)
                    {
                        <option value="@genre">@genre</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-4 g-4" id="gamesContainer">
        
        @foreach (var game in Model.Games)
        {
            <div class="col game-card" data-title="@game.Title.ToLower()" data-genre="@game.Genre">
                <div class="card h-100 shadow-sm border-0 rounded-3">
                    <img src="@game.ImageUrl" onerror="this.onerror=null; this.src='/images/placeholder.jgp';" class="card-img-top rounded-top" alt="Okładka" style="object-fit: cover; height: 350px;">
                    
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-truncate" title="@game.Title">@game.Title</h5>
                        <p class="card-text text-muted small mb-1">@game.Developer &bull; @game.ReleaseYear</p>
                        
                        <div class="mt-auto pt-2">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-dark">@game.Genre</span>
        
                                @if (Context.Session.GetString("UserRole") == "Admin")
                                {
                                    <a asp-action="Edit" asp-route-id="@game.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Edytuj grę w bazie">
                                        <i class="fa-solid fa-pen-to-square"></i> Edytuj dane
                                    </a>
                                }
                            </div>
                            
                            @if (Context.Session.GetInt32("UserId") != null)
                            {
                                if (game.IsInLibrary)
                                {
                                    <button class="btn bg-success btn-secondary w-100 fw-bold" disabled>
                                        <i class="fa-solid fa-check"></i> Dodano
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-success w-100 fw-bold quick-add-btn" data-game-id="@game.Id">
                                        + Do biblioteki
                                    </button>
                                }
                            }
                            else
                            {
                                <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary w-100 fw-bold">Zaloguj by dodać</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div id="noResultsMessage" class="alert alert-warning text-center mt-4 d-none">
        Niestety, nie znaleziono żadnych gier spełniających Twoje kryteria.
    </div>
</div>

@section scripts {
    <script src="~/js/Catalog Filter.js"></script>
    <script src="~/js/QuickAdd.js"></script>
}