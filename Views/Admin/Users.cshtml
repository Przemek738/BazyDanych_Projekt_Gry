@model IEnumerable<BacklogManager.DTOs.UserListViewModel>

@{
    ViewData["Title"] = "Zarządzanie Użytkownikami";
}

<div class="container mt-4">
    <h2 class="fw-bold text-danger mb-4"><i class="fa-solid fa-user-shield"></i> Panel Administratora</h2>

    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white py-3">
            <h5 class="mb-0 fw-bold">Zarejestrowane konta w systemie</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nazwa użytkownika</th>
                            <th>Adres E-mail</th>
                            <th>Rola</th>
                            <th class="text-end pe-4">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 text-muted">@user.Id</td>
                                <td class="fw-bold">@user.Username</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-secondary")">
                                        @user.Role
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <form asp-action="ToggleRole" asp-route-id="@user.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-dark">
                                                Zmień na @(user.Role == "Admin" ? "User" : "Admin")
                                            </button>
                                        </form>

                                        <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Czy na pewno chcesz bezpowrotnie usunąć tego użytkownika i całą jego bibliotekę?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash"></i> Usuń
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>