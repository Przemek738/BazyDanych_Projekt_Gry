@model BacklogManager.DTOs.LoginViewModel

@{
    ViewData["Title"] = "Logowanie";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white text-center py-3 rounded-top">
                    <h4 class="mb-0 fw-bold">Witamy ponownie!</h4>
                </div>
                <div class="card-body p-4">
                    
                    @if (TempData["WarningMessage"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i> 
                            <strong>Uwaga!</strong> @TempData["WarningMessage"]
        
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zamknij"></button>
                        </div>
                    }

                    <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

                    <form asp-controller="Auth" asp-action="Login" method="post">

                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">Nazwa użytkownika</label>
                            <input asp-for="Username" class="form-control" placeholder="Twój nick..." required/>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold">Hasło</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Twoje hasło..." required/>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-bold mb-3">
                            Zaloguj się
                        </button>
                    </form>

                </div>
                <div class="card-footer bg-light text-center py-3">
                    <span class="text-muted">Nie masz konta?</span> 
                    <a asp-controller="Auth" asp-action="Register" class="fw-bold text-decoration-none">Zarejestruj się</a>
                </div>
            </div>
        </div>
    </div>
</div>