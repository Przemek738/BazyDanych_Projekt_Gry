@model IEnumerable<BacklogManager.DTOs.UserGameIndexViewModel>

@{
    ViewData["Title"] = "Moja Biblioteka";
}

<div class="container mt-4">
    <h2 class="fw-bold text-primary mb-4">Moja Kolekcja Gier</h2>

    @if (!Model.Any())
    {
        <div class="text-center p-5 bg-light rounded-3 shadow-sm">
            <h3>Twoja biblioteka jest pusta 🎮</h3>
            <p class="text-muted">Przejdź do katalogu i dodaj swoją pierwszą grę!</p>
            <a asp-controller="Game" asp-action="Index" class="btn btn-primary fw-bold">Przeglądaj Katalog</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="row g-0 h-100">
                            <div class="col-4">
                                <img src="@item.ImageUrl" onerror="this.onerror=null; this.src='/images/placeholder.jgp';" class="img-fluid rounded-start h-100" style="object-fit: cover;" alt="Okładka">
                            </div>
                            <div class="col-8">
                                <div class="card-body d-flex flex-column h-100">
                                    <h5 class="card-title fw-bold">@item.GameTitle</h5>
                                    <p class="mb-1">
                                        @foreach (var platform in item.PlatformNames)
                                        {
                                            <span class="badge bg-info text-dark me-1">@platform</span>
                                        }
                                    </p>
                                    <p class="mb-1"><span class="badge @(item.Status == "Ukończona" ? "bg-success" : "bg-warning text-dark")">@item.Status</span></p>

                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <p class="card-text small text-muted mt-2 mb-0"><strong>Notatki:</strong></p>
                                        <p class="card-text small text-muted text-break" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
                                            @item.Notes
                                        </p>
                                    }
                                    
                                    <div class="mt-auto pt-3 d-flex justify-content-between">
                                        <a asp-action="Edit" asp-route-id="@item.UserGameId" class="btn btn-sm btn-outline-primary me-2">Edytuj</a>
                                        <form asp-action="Delete" asp-route-id="@item.UserGameId" method="post" onsubmit="return confirm('Usunąć z kolekcji?')">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>