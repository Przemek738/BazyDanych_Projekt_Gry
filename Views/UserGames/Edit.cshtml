@model BacklogManager.DTOs.AddToLibraryViewModel

@{
    ViewData["Title"] = "Dodaj do kolekcji";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0 fw-bold">Dodaj do swojej biblioteki</h4>
                </div>
                <div class="card-body p-4">
                    <h5 class="text-center mb-4 text-muted">Gra: <strong>@Model.GameTitle</strong></h5>

                    <form asp-action="Edit" asp-route-id="@ViewBag.UserGameId" method="post">
                        <input type="hidden" asp-for="GameId" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Wybierz platformy</label>
                            <div class="d-flex flex-wrap gap-3 mt-1">
                                @foreach (var p in Model.AvailablePlatforms)
                                {
                                    bool isChecked = Model.SelectedPlatformIds != null && Model.SelectedPlatformIds.Contains(p.Id);
                                    
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedPlatformIds" value="@p.Id" id="plat_@p.Id" @(isChecked ? "checked" : "")>
                                        <label class="form-check-label" for="plat_@p.Id">@p.Name</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Status gry</label>
                            <select asp-for="Status" class="form-select">
                                <option>Planuję zagrać</option>
                                <option>W trakcie</option>
                                <option>Ukończona</option>
                                <option>Porzucona</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Prywatne notatki</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" maxlength="200" placeholder="max 200 znaków"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-controller="UserGames" asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
                            <button type="submit" class="btn btn-success fw-bold px-4">Dodaj do kolekcji</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>